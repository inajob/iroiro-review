      <pubDate>Tue, 26 Mar 2024 23:47:51 +0000</pubDate>
      
      <guid>https://inajob.github.io/iroiro-review/post/%E3%83%87%E3%82%B8%E3%82%BF%E3%83%AB%E7%89%88%E3%83%8F%E3%83%BC%E3%83%87%E3%82%A3%E3%82%AC%E3%83%BC%E3%83%87%E3%82%A3/</guid>
      <description>&lt;img src="https://inajob.github.io/iroiro-review/img/デジタル版ハーディ・ガーディ.jpg"&gt;Ancient Instrument Goes Digital: The Digi-Gurdyから発見。画像もここから転載。
