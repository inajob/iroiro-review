    <item>
      <title>CoreXYの自作ペンプロッタ</title>
      <link>https://inajob.github.io/iroiro-review/post/corexy%E3%81%AE%E8%87%AA%E4%BD%9C%E3%83%9A%E3%83%B3%E3%83%97%E3%83%AD%E3%83%83%E3%82%BF/</link>
