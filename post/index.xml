      <pubDate>Tue, 10 Jun 2025 23:37:40 +0000</pubDate>
      
      <guid>https://inajob.github.io/iroiro-review/post/%E3%82%B9%E3%83%88%E3%83%AD%E3%83%BC%E7%8A%B6%E3%81%AE%E8%A2%8B%E3%81%AB%E7%A9%BA%E6%B0%97%E3%82%92%E5%85%A5%E3%82%8C%E3%82%8B%E3%81%A8%E6%8C%AF%E5%8B%95%E3%81%99%E3%82%8B%E7%8F%BE%E8%B1%A1%E3%82%92%E4%BD%BF%E3%81%A3%E3%81%A6%E6%AD%A9%E8%A1%8C%E3%81%95%E3%81%9B%E3%82%8B%E5%AE%9F%E9%A8%93/</guid>
